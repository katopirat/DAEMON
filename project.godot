HorrorState="*uid://too3l6wickcp"
Notifications="*uid://bco0wh20n2y6s"
GameFiles="*uid://bftjddmhylqmg"
SaveGame="*uid://bj6s3c8j2j4w3"
Settings="*uid://sl3o3lehl1q"

[display]

window/size/borderless=true
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "teal",
"res://assets/audio/": "yellow",
"res://os_files/": "red",
"res://scenes/": "purple"
}

